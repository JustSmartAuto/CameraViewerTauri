<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CameraViewerGigE</AssemblyName>
    <RootNamespace>CameraViewerGigE</RootNamespace>
    <Product>CameraViewerGigE</Product>
    <Version>26.10.14.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>CameraViewerGigE.App</StartupObject>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="FluentFTP" Version="50.1.0" />
    <EmbeddedResource Include="Assets\hmi-i18n.js" />
  </ItemGroup>

  <!-- OPT SciCamera 托管程序集（原生库由 SciCamNative 在运行时从 SDK 目录加载） -->
  <ItemGroup>
    <Reference Include="SciCamera.Net">
      <HintPath>..\opt-camera-sdk\SciCamera.Net.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- WebView2 包会无条件引用其 WPF 程序集，本应用已迁移到 WinForms，移除该引用以避免 WindowsBase 版本冲突警告 -->
  <Target Name="RemoveWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WebView2WpfRef Include="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
      <Reference Remove="@(_WebView2WpfRef)" />
    </ItemGroup>
  </Target>

</Project>
